# Copy to .env.local. All three services read this file. Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URLs of each service
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VIDEO_INTERVIEW_URL=http://127.0.0.1:5001
NEXT_PUBLIC_CLIENT_SIDE_FRONTEND_URL=http://localhost:8080

# Shared by the main app and the interview service. Generate with: openssl rand -hex 32
INTERVIEW_SERVICE_SECRET=
# Optional: origins allowed to call the interview service's health check (comma-separated)
INTERVIEW_ALLOWED_ORIGINS=http://localhost:3000

# AI. Secrets must never use the NEXT_PUBLIC_ prefix, which publishes the value to browsers.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Email. Without these, stages still advance and HR is shown interview links to share by hand.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Resume API: origins allowed to call it (comma-separated)
RESUME_API_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
# Optional: lets the resume API fetch job links through RapidAPI's JSearch
RAPIDAPI_KEY=

# In "Client Side/ai-skill-analyzer-main/.env":
#   VITE_BACKEND_URL=http://127.0.0.1:8000
#   VITE_MAIN_APP_URL=http://localhost:3000
